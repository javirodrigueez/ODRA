graph LR
    %% Styling Definitions
    classDef init fill:#e8f4f8,stroke:#2b7b96,stroke-width:2px;
    classDef cbtStage fill:#f9f0ff,stroke:#9370db,stroke-width:2px;
    classDef miStage fill:#fff0f5,stroke:#ff69b4,stroke-width:2px;
    classDef logic fill:#fffacd,stroke:#ffd700,stroke-width:2px;
    classDef terminal fill:#f0f0f0,stroke:#333,stroke-width:2px;

    Start((Start Session)):::terminal --> Init[Init R based on Attitude: Neg=0.75, Neu=0.5, Pos=0.25]:::init
    Init --> FirstUttCheck

    %% 1. OPENING STAGE
    subgraph Stage1 [1. Opening Stage]
        FirstUttCheck{Is first utterance?}:::logic
        
        %% Step 1: Greeting
        BriefGreeting[Therapist: Brief Greeting]
        PatRespGreeting[Patient Responds]
        
        %% Step 2: Check and Update Info
        CheckPrevInfo[Check Prev. Utterance for Mood/Problem]
        UpdateInfoCheck{Info Provided?}:::logic
        UpdateSavedInfo[Update Saved Mood/Problem]
        
        %% Step 3: Check Readiness
        CheckEnoughInfo{Enough Info Collected?}:::logic
        CheckMissing{What is missing?}:::logic
        
        %% Steps 4 & 5: Gather Missing Info
        GatherMood[Therapist: Gather Mood Info]
        PatRespMood[Patient Responds]
        
        GatherProblem[Therapist: Gather Problem Info]
        PatRespProb[Patient Responds]

        %% 1. First Utterance Flow
        FirstUttCheck -- Yes --> BriefGreeting
        BriefGreeting --> PatRespGreeting
        PatRespGreeting --> CheckPrevInfo
        FirstUttCheck -- No --> CheckPrevInfo

        %% 2. Info Update Flow
        CheckPrevInfo --> UpdateInfoCheck
        UpdateInfoCheck -- Yes --> UpdateSavedInfo
        UpdateSavedInfo --> CheckEnoughInfo
        UpdateInfoCheck -- No --> CheckEnoughInfo

        %% 3. Readiness Flow
        CheckEnoughInfo -- No --> CheckMissing
        
        %% 4. Gather Mood Flow
        CheckMissing -- "Refine Mood" --> GatherMood
        GatherMood --> PatRespMood
        PatRespMood --> CheckPrevInfo
        
        %% 5. Gather Problem Flow
        CheckMissing -- "Refine Problem" --> GatherProblem
        GatherProblem --> PatRespProb
        PatRespProb --> CheckPrevInfo
    end

    %% END of Stage 1 (Step 3 Yes)
    CheckEnoughInfo -- Yes --> PostOpenR{Evaluate Post-Opening R}:::logic

    %% POST-OPENING RESISTANCE ROUTING
    PostOpenR -- "R > 0.75 (Precontemplation)" --> MITopicStart
    PostOpenR -- "0.5 < R <= 0.75 (Contemplation)" --> MITechStart
    PostOpenR -- "R <= 0.5 (Action)" --> CBT_Gateway

    %% MI TOPIC EXPLORATION (Precontemplation)
    subgraph MI_Topic [MI Topic Exploration]
        MITopicStart[Select MI Topic: Health, Economy, etc.] --> MITopicMiddle[MI Topic Utterance]
        MITopicMiddle[MI Topic Utterance] --> MITopicResp[Patient Responds]
        MITopicResp --> UpdateR1[Update R]
        UpdateR1 --> CheckR1Trend{Check R Trend}:::logic
        CheckR1Trend -- "Higher R" --> MITopicStart
        CheckR1Trend -- "Lower R (Still > 0.75)" --> MITopicMiddle
    end

    CheckR1Trend -- "R <= 0.75" --> MITechStart

    %% MI TECHNIQUES (Contemplation & CBT Interruption)
    subgraph MI_Tech [MI Techniques]
        MITechStart[Select MI Technique: Advise, Affirm, etc.] --> MITechResp[Patient Responds]
        MITechResp --> UpdateR2[Update R]
        UpdateR2 --> CheckR2Trend{Check R Trend}:::logic
        CheckR2Trend -- "Higher R: Prompt similar tech." --> MITechStart
        CheckR2Trend -- "Lower R (Still > 0.5): Prompt diff. tech." --> MITechStart
    end

    CheckR2Trend -- "R <= 0.5" --> RestoreCBT[Restore CBT State / Enter CBT]
    RestoreCBT --> CBT_Gateway

    %% CONTINUOUS CBT FLOW & INTERRUPTION CHECK
    subgraph CBT_Main [CBT Flow & Action State]
        CBT_Gateway{Prior to Utt: R <= 0.5?}:::logic
        
        CBT_Gateway -- No --> SaveState[Save CBT State Summary]
        SaveState --> MITechStart

        CBT_Gateway -- Yes --> ID_DistStart
        
        %% 2. ID DISTORTIONS
        subgraph Stage2 [2. Id. Distortions]
            ID_DistStart[Identify Situation] --> ExtractLoop[Extract Thoughts, Emotions, Behaviors]
            ExtractLoop --> InferCore[Infer Core Belief]
            InferCore --> AssignDist[Assign Highest Prob Distortion]
            AssignDist --> CheckDist{3 Sets & Enough Info?}:::logic
            CheckDist -- No --> ID_DistStart
        end
        
        CheckDist -- Yes --> CBT_TechStart

        %% 3. CBT TECHNIQUE (Updated to match Python logic)
        subgraph Stage3 [3. CBT Technique]
            CBT_TechStart[Select Initial Techniques] --> DecideNext{Enough Techniques?}:::logic
            
            %% Decide Next Flow
            DecideNext -- Yes --> EndCBT[Finish CBT Stage]
            DecideNext -- No --> CheckSelected{All Selected Done?}:::logic
            
            CheckSelected -- Yes --> SelectAdd[Select Additional Technique]
            SelectAdd --> PlanCurrent
            
            CheckSelected -- No --> ValidateFit{Next Tech Fits?}:::logic
            ValidateFit -- No --> ReplaceTech[Replace Technique]
            ValidateFit -- Yes --> PlanCurrent
            ReplaceTech --> PlanCurrent
            
            %% Plan & Deliver Flow
            PlanCurrent[Create / Update Detailed Plan] --> DeliverCurrent[Therapist Utterance]
            DeliverCurrent --> PatRespCBT[Patient Responds]
            PatRespCBT --> ReviewCurrent{Technique Complete?}:::logic
            
            %% Review Flow
            ReviewCurrent -- No --> PlanCurrent
            ReviewCurrent -- Yes --> EvalTech[Evaluate & Complete Tech]
            EvalTech --> DecideNext
        end
    end

    %% Transition to Homework
    EndCBT --> HWStart

    %% 4. HOMEWORK
    subgraph Stage4 [4. Homework]
        HWStart[Propose Homework] --> NegHW[Patient Feedback]
        NegHW --> CheckHW{Agreement?}:::logic
        CheckHW -- No --> HWStart
    end

    CheckHW -- Yes --> ClosingStart

    %% 5. CLOSING
    subgraph Stage5 [5. Closing]
        ClosingStart[Summarize Session] --> NextPlan[Propose Next Plan]
        NextPlan --> CheckPlan{Agreement?}:::logic

        CheckPlan -- Yes --> AskFB[Request Feedback]
        CheckPlan -- No --> NextPlan
    end

    AskFB --> End((End Session)):::terminal

    %% Apply Classes
    class Stage1,Stage2,Stage3,Stage4,Stage5 cbtStage;
    class MI_Topic,MI_Tech miStage;