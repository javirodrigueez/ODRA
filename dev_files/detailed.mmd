graph LR
    %% Styling Definitions
    classDef init fill:#e8f4f8,stroke:#2b7b96,stroke-width:2px;
    classDef cbtStage fill:#f9f0ff,stroke:#9370db,stroke-width:2px;
    classDef miStage fill:#fff0f5,stroke:#ff69b4,stroke-width:2px;
    classDef logic fill:#fffacd,stroke:#ffd700,stroke-width:2px;
    classDef terminal fill:#f0f0f0,stroke:#333,stroke-width:2px;

    Start((Start Session)):::terminal --> Init[Init R based on Attitude]:::init
    Init --> FirstUttCheck

    %% 1. OPENING STAGE
    subgraph Stage1 [1. Opening Stage]
        FirstUttCheck{Is first utterance?}:::logic
        
        BriefGreeting[Therapist: Brief Greeting]
        PatRespGreeting[Patient Responds]
        
        CheckPrevInfo[Check Prev. Utterance for Mood/Problem]
        UpdateInfoCheck{Info Provided?}:::logic
        UpdateSavedInfo[Update Saved Mood/Problem]
        
        CheckEnoughInfo{Enough Info Collected?}:::logic
        CheckMissing{What is missing?}:::logic
        
        GatherMood[Therapist: Gather Mood Info]
        PatRespMood[Patient Responds]
        
        GatherProblem[Therapist: Gather Problem Info]
        PatRespProb[Patient Responds]

        FirstUttCheck -- Yes --> BriefGreeting
        BriefGreeting --> PatRespGreeting
        PatRespGreeting --> CheckPrevInfo
        FirstUttCheck -- No --> CheckPrevInfo

        CheckPrevInfo --> UpdateInfoCheck
        UpdateInfoCheck -- Yes --> UpdateSavedInfo
        UpdateSavedInfo --> CheckEnoughInfo
        UpdateInfoCheck -- No --> CheckEnoughInfo

        CheckEnoughInfo -- No --> CheckMissing
        
        CheckMissing -- "Refine Mood" --> GatherMood
        GatherMood --> PatRespMood
        PatRespMood --> CheckPrevInfo
        
        CheckMissing -- "Refine Problem" --> GatherProblem
        GatherProblem --> PatRespProb
        PatRespProb --> CheckPrevInfo
    end

    %% END of Stage 1
    CheckEnoughInfo -- Yes --> PostOpenR{Evaluate Post-Opening R Band}:::logic

    %% POST-OPENING RESISTANCE ROUTING
    PostOpenR -- "Precontemplation" --> MI_Topic_Entry
    PostOpenR -- "Contemplation" --> MI_Tech_Entry
    PostOpenR -- "Action" --> ID_DistEntry

    %% MI TOPIC EXPLORATION
    subgraph MI_Topic [MI Topic Exploration]
        MI_Topic_Entry{Need New Topic / R Increased?}:::logic
        MI_Topic_Entry -- Yes --> MI_Choose_Topic[Select Topic from Catalog]
        MI_Topic_Entry -- No --> MI_Raise_Topic
        
        MI_Choose_Topic --> TopicExhaustCheck{All Topics Tried & Precontemplation?}:::logic
        TopicExhaustCheck -- Yes --> Meta_Entry
        TopicExhaustCheck -- No --> MI_Raise_Topic[Raise Topic Utterance]
        
        MI_Raise_Topic --> MI_Topic_Resp[Patient Responds]
        MI_Topic_Resp --> Update_R_Topic[Update Predicted R]
        
        Update_R_Topic --> Topic_R_Check{Check Current R Band}:::logic
        Topic_R_Check -- "Precontemplation" --> MI_Topic_Entry
    end
    Topic_R_Check -- "Contemplation / Action" --> MI_Tech_Entry

    %% MI TECHNIQUES
    subgraph MI_Tech [MI Techniques]
        MI_Tech_Entry{Check MI Tech Pre-Conditions}:::logic
        MI_Tech_Entry -- "R == Precontemplation" --> MI_Topic_Entry
        MI_Tech_Entry -- "R == Action" --> MI_Eval[Evaluate MI & Record Reason]
        MI_Tech_Entry -- "Exchanges >= 10" --> MI_Pause[Pause Techs until Precont. & Evaluate]
        
        MI_Tech_Entry -- "Continue" --> MI_Choose_Tech[Select Technique]
        MI_Choose_Tech --> MI_Raise_Tech[Raise Technique Utterance]
        MI_Raise_Tech --> MI_Tech_Resp[Patient Responds]
        MI_Tech_Resp --> Update_R_Tech[Update Predicted R]
        
        Update_R_Tech --> MI_Tech_Entry
        
        MI_Pause --> TransitionToCBT[Transition back to CBT Stage]
        MI_Eval --> TransitionToCBT
    end

    %% META CONVERSATION
    subgraph Meta_Conv [Meta Conversation]
        Meta_Entry{Check R Band & Turns}:::logic
        Meta_Entry -- "Contemplation / Action" --> MI_Tech_Entry
        Meta_Entry -- "Turns >= 8 & Precont." --> Anticipated_Closing[Anticipated Closing]
        
        Meta_Entry -- "Turns < 8" --> Meta_Routing{Turns Count Substage}:::logic
        Meta_Routing -- "0" --> Meta_Open[Meta Open]
        Meta_Routing -- "1" --> Meta_Probe[Meta Probe]
        Meta_Routing -- "2+" --> Meta_Adjust[Meta Adjust]
        Meta_Routing -- "Requested End" --> Meta_Close[Meta Close]
        
        Meta_Open --> Meta_Resp[Patient Responds]
        Meta_Probe --> Meta_Resp
        Meta_Adjust --> Meta_Resp
        Meta_Resp --> Update_R_Meta[Update Predicted R]
        Update_R_Meta --> Meta_Entry
    end
    
    Meta_Close --> End((End Session)):::terminal
    Anticipated_Closing --> End

    %% CBT INTERRUPTS (Reflecting _handle_pre_stage_routing inside CBT_STAGES)
    TransitionToCBT --> CBT_Gateway
    
    %% CONTINUOUS CBT FLOW
    subgraph CBT_Main [CBT Flow & Action State]
        CBT_Gateway{Check Current R Band}:::logic
        
        %% Interrupts
        CBT_Gateway -- "Contemplation (if not paused)" --> SaveStateTech[Save CBT State]
        SaveStateTech --> MI_Tech_Entry
        
        CBT_Gateway -- "Precontemplation" --> SaveStateTopic[Save CBT State & Unpause MI Techs]
        SaveStateTopic --> MI_Topic_Entry
        
        %% Flow
        CBT_Gateway -- "Action" --> ID_DistEntry
        
        %% 2. ID DISTORTIONS
        subgraph Stage2 [2. Id. Distortions]
            ID_DistEntry[Enter / Resume ID Distortions] --> CheckBootstrap{Is Bootstrap Substage?}:::logic
            
            CheckBootstrap -- Yes --> Bootstrap[Bootstrap First Cognitive Model]
            Bootstrap --> ReviewGap
            CheckBootstrap -- No --> ReviewGap[Plan & Ask: Cognitive Gaps]
            
            ReviewGap --> HasGapQ{Gap Question Generated?}:::logic
            HasGapQ -- Yes --> DeliverID[Deliver Utterance]
            HasGapQ -- No --> Refinement[Refine & Ask: Min Exchanges]
            
            Refinement --> HasRefQ{Refinement Question Gen?}:::logic
            HasRefQ -- Yes --> DeliverID
            HasRefQ -- No --> AssignCore[Assign Core Belief]
            
            AssignCore --> AssignDist[Assign Highest Prob. Distortion]
            AssignDist --> CommitSet[Commit Set & Reset Working Area]
            CommitSet --> CheckCompletion{Distortion ID Completed?}:::logic
            
            CheckCompletion -- No --> ReviewGap
            
            DeliverID --> PatRespID[Patient Responds]
            PatRespID --> CBT_Gateway
        end
        CheckCompletion -- Yes --> CBT_TechStart

        %% 3. CBT TECHNIQUE
        subgraph Stage3 [3. CBT Technique]
            CBT_TechStart[Select Initial Techniques] --> DecideNext{Enough Techniques?}:::logic
            DecideNext -- Yes --> EndCBT[Finish CBT Stage]
            DecideNext -- No --> CheckSelected{All Selected Done?}:::logic
            
            CheckSelected -- Yes --> SelectAdd[Select Additional Technique]
            SelectAdd --> PlanCurrent
            
            CheckSelected -- No --> ValidateFit{Next Tech Fits?}:::logic
            ValidateFit -- No --> ReplaceTech[Replace Technique]
            ValidateFit -- Yes --> PlanCurrent
            ReplaceTech --> PlanCurrent
            
            PlanCurrent[Create / Update Detailed Plan] --> DeliverCurrent[Deliver Utterance]
            DeliverCurrent --> PatRespCBT[Patient Responds]
            PatRespCBT --> CBT_Gateway
        end
    end
    
    %% Routing logic check after CBT iterations (simulating intercept back to CBT Gateway)
    ReviewCurrent{Technique Complete?}:::logic
    PatRespCBT -.-> ReviewCurrent
    ReviewCurrent -- No --> PlanCurrent
    ReviewCurrent -- Yes --> EvalTech[Evaluate & Complete Tech]
    EvalTech --> DecideNext

    EndCBT --> HWStart

    %% 4. HOMEWORK
    subgraph Stage4 [4. Homework]
        HWStart{Determine Substage}:::logic
        
        HWStart -- "Propose Tasks" --> ProposeHW[Propose 1-2 Tasks & Increment Attempts]
        ProposeHW --> DeliverHW[Deliver Proposal Utterance]
        DeliverHW --> PatRespHW[Patient Responds]
        
        PatRespHW --> ReviewHW[Review Response]
        ReviewHW --> CheckHW{Agreement Reached?}:::logic
        
        CheckHW -- No --> CheckAttempts{Attempts >= 5?}:::logic
        CheckAttempts -- No --> HWStart
        
        CheckAttempts -- Yes --> ApplyFallback[Apply Minimal Fallback Task]
        ApplyFallback --> DeliverFallback[Deliver Fallback Utterance]
        DeliverFallback --> PatRespFallback[Patient Responds]
        PatRespFallback --> EndFallback[Acknowledge Stance & Transition]
    end

    %% Transition to Closing
    CheckHW -- Yes --> ShareSummary
    EndFallback --> ShareSummary

    %% 5. CLOSING
    subgraph Stage5 [5. Closing]
        ShareSummary[Session Summary] --> SharePlan[Next Session Plan]
        
        SharePlan --> ReviewPlan{Plan Agreed or Refinements >= 10?}:::logic
        
        ReviewPlan -- No --> RevisePlan[Plan Refinement]
        RevisePlan --> ReviewPlan
        
        ReviewPlan -- Yes --> AskFB[Ask for Feedback]
        AskFB --> FinalClose[Final Closing]
    end

    FinalClose --> End

    %% Apply Classes
    class Stage1,Stage2,Stage3,Stage4,Stage5 cbtStage;
    class MI_Topic,MI_Tech,Meta_Conv miStage;